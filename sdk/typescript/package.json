{
  "name": "@prymestudy/connect",
  "version": "1.0.0",
  "description": "Official TypeScript/Node.js SDK for PrymeStudy Connect institutional integrations.",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
