{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PrymeStudy Connect Webhook Event v1",
  "type": "object",
  "required": ["id", "type", "created_at", "environment", "integration_id", "data"],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128
    },
    "type": {
      "type": "string",
      "minLength": 3,
      "maxLength": 160,
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)+$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "environment": {
      "type": "string",
      "enum": ["sandbox", "production"]
    },
    "integration_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128
    },
    "resource": {
      "type": ["object", "null"],
      "properties": {
        "type": {"type": "string", "maxLength": 128},
        "id": {"type": "string", "maxLength": 255},
        "version": {"type": ["string", "integer", "null"]}
      },
      "additionalProperties": false
    },
    "data": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
