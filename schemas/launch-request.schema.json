{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PrymeStudy Connect Launch Request v1",
  "type": "object",
  "required": ["external_subject", "identity", "academic"],
  "properties": {
    "external_subject": {
      "type": "string",
      "minLength": 8,
      "maxLength": 255
    },
    "identity": {
      "type": "object",
      "required": ["first_name", "last_name"],
      "properties": {
        "first_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "last_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "other_name": {
          "type": ["string", "null"],
          "maxLength": 120
        },
        "email": {
          "type": ["string", "null"],
          "format": "email",
          "maxLength": 254
        },
        "email_verified_by_partner": {
          "type": "boolean",
          "default": false
        },
        "phone": {
          "type": ["string", "null"],
          "maxLength": 32
        },
        "matric_number": {
          "type": ["string", "null"],
          "maxLength": 128
        }
      },
      "additionalProperties": false
    },
    "academic": {
      "$ref": "academic-claims.schema.json"
    },
    "return_url": {
      "type": ["string", "null"],
      "format": "uri",
      "maxLength": 2048
    },
    "correlation_id": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 128
    }
  },
  "additionalProperties": false
}
